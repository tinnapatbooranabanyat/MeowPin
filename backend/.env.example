# คัดลอกเป็น .env แล้วใส่ค่าจริง (.env ไม่ถูก commit)
# Supabase Dashboard → Project Settings → API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
# ใช้ "Secret key" (sb_secret_...) หรือ service_role แบบเก่า — ห้ามใส่ใน frontend เด็ดขาด
SUPABASE_SECRET_KEY=

# อีเมล Google ของเจ้าของแพลตฟอร์ม (คั่นด้วย ,) — ล็อกอินด้วยอีเมลนี้จะเป็น admin อัตโนมัติ
ADMIN_EMAILS=

# สรุปแมวด้วย AI — สร้าง key ฟรีที่ https://aistudio.google.com/apikey (ว่าง = ปิดฟีเจอร์นี้)
GEMINI_API_KEY=
# gemini-3.8-flash (ค่าเริ่มต้น) หรือ gemini-3.5-flash-lite (ถูก/เร็วกว่า)
GEMINI_MODEL=gemini-3.8-flash

# โดเมน frontend ที่อนุญาตให้เรียก API (คั่นด้วย ,)
ALLOWED_ORIGINS=http://localhost:5173
