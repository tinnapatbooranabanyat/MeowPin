# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local ไม่ถูก commit ขึ้น GitHub)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Supabase Dashboard → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# ใส่ได้เฉพาะ publishable/anon key เท่านั้น ห้ามใส่ secret key ใน frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL ของ backend FastAPI (ตอน deploy เปลี่ยนเป็น URL ของ Render)
VITE_API_URL=http://localhost:8000

# ถ้า VITE_SUPABASE_* หรือ VITE_API_URL ว่าง แอปจะใช้ข้อมูลจำลองแทน
